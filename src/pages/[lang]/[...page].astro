---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { languages, pages, t, url, asset, type Lang, type UiKey } from '../../i18n/ui';
import { content } from '../../i18n/content';
import { research } from '../../i18n/research';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    pages.map((p) => ({ params: { lang, page: p || undefined }, props: { lang, path: p } })),
  );
}
const { lang, path } = Astro.props as { lang: Lang; path: string };
const navKey = (path ? `nav.${path}` : 'nav.home') as UiKey;
const c = content[lang];
const r = research[lang];
---
<Base lang={lang} path={path} title={path ? t(lang, navKey) : undefined}>
  {path === '' && (
    <>
      <h1>{c.home.hello}</h1>
      <p class="lead">{c.home.intro}</p>

      <h2>{c.home.interestsTitle}</h2>
      <div class="grid">
        {c.home.interests.map((i) => (
          <div class="card"><h3>{i.title}</h3><p>{i.body}</p></div>
        ))}
      </div>

      <h2>{c.home.featuredTitle}</h2>
      <article class="card">
        <h3>{c.home.featured.title} <span class="badge">{c.home.featured.status}</span></h3>
        <p>{c.home.featured.body}</p>
        <a href={url(lang, 'research/')}>{c.home.featured.cta} →</a>
      </article>

      <h2>{c.home.wiki.title}</h2>
      <article class="card">
        <p>{c.home.wiki.body}</p>
        <a href={url(lang, 'wiki/')}>{c.home.wiki.cta} →</a>
      </article>

      <h2>{c.home.projectsTitle}</h2>
      <div class="stack">
        {c.projects.items.map((p) => (
          <ProjectCard project={p} repoLabel={c.projects.repoLabel} liveLabel={c.projects.liveLabel} />
        ))}
      </div>
      <p><a href={url(lang, 'projects/')}>{c.home.allProjects} →</a></p>
    </>
  )}

  {path === 'projects' && (
    <>
      <h1>{c.projects.title}</h1>
      <p class="muted">{c.projects.lead}</p>
      <div class="stack">
        {c.projects.items.map((p) => (
          <ProjectCard project={p} repoLabel={c.projects.repoLabel} liveLabel={c.projects.liveLabel} />
        ))}
      </div>
    </>
  )}

  {path === 'about' && (
    <>
      <h1>{c.about.title}</h1>
      {c.about.paragraphs.map((p) => <p>{p}</p>)}
      <h2>{c.about.learningTitle}</h2>
      <ul>{c.about.learning.map((l) => <li>{l}</li>)}</ul>
      <h2>{c.about.toolsTitle}</h2>
      <ul class="chips">{c.about.tools.map((l) => <li>{l}</li>)}</ul>
      <h2>{c.about.linksTitle}</h2>
      <ul><li><a href="https://github.com/Taegyu-Park">GitHub</a></li></ul>
    </>
  )}

  {path === 'research' && (
    <>
      <h1>{r.title} <span class="badge">{r.status}</span></h1>
      <p class="lead">{r.lead}</p>
      {r.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.bullets && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}
          {s.figures?.map((f) => (
            <figure>
              <img src={asset(`images/research/${f.src}`)} alt={f.alt} loading="lazy" />
              <figcaption class="muted">{f.caption}</figcaption>
            </figure>
          ))}
        </section>
      ))}
      <p class="muted note">{r.note}</p>
    </>
  )}

  {path === 'wiki' && (
    <>
      <h1>{t(lang, navKey)}</h1>
      <p class="muted">{t(lang, 'placeholder')}</p>
    </>
  )}
</Base>

<style>
  .lead { font-size: 1.1rem; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .stack { display: grid; gap: 12px; }
  h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .card p { margin: 0 0 10px; }
  .badge { font-size: 0.75rem; font-weight: 400; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0 8px; margin-left: 6px; vertical-align: middle; }
  figure { margin: 16px 0; }
  figure img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
  figcaption { font-size: 0.9rem; margin-top: 6px; text-align: center; }
  .note { margin-top: 40px; font-size: 0.9rem; }
  .chips { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; padding: 0; }
  .chips li { border: 1px solid var(--line); border-radius: 999px; padding: 0 12px; }
</style>
